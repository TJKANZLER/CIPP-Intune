{
  "@odata.type": "#microsoft.graph.androidDeviceOwnerGeneralDeviceConfiguration",
  "displayName": "Baseline - Android Enterprise (Fully Managed) - Device Restrictions",
  "description": "Security hardening for Android Enterprise corporate-owned, single-user fully managed devices: blocks sideloading, developer options, USB file transfer, external media and screen capture; blocks personal Google accounts; enforces Play Protect, automatic app and system updates, a six-digit complex PIN and lockout-to-wipe. The kiosk-only network escape hatch is disabled. A CIPP tenant variable supplies the controlled Factory Reset Protection recovery account.",
  "roleScopeTagIds": ["0"],

  "appsAllowInstallFromUnknownSources": false,
  "securityRequireVerifyApps": true,
  "securityDeveloperSettingsEnabled": false,
  "appsDefaultPermissionPolicy": "deviceDefault",
  "appsAutoUpdatePolicy": "always",

  "factoryResetBlocked": true,
  "factoryResetDeviceAdministratorEmails": [
    "%androidfrprecoveryaccount%"
  ],
  "networkEscapeHatchAllowed": false,

  "storageBlockUsbFileTransfer": true,
  "storageBlockExternalMedia": true,
  "screenCaptureBlocked": true,

  "passwordRequiredType": "numericComplex",
  "passwordMinimumLength": 6,
  "passwordMinutesOfInactivityBeforeScreenTimeout": 15,
  "passwordSignInFailureCountBeforeFactoryReset": 10,

  "googleAccountsBlocked": true,
  "bluetoothBlockContactSharing": true,
  "nfcBlockOutgoingBeam": true,
  "dateTimeConfigurationBlocked": true,
  "wifiBlockEditPolicyDefinedConfigurations": true,

  "systemUpdateInstallType": "automatic",

  "cameraBlocked": false,
  "dataRoamingBlocked": false,
  "bluetoothBlockConfiguration": false,
  "volumeBlockAdjustment": false,
  "statusBarBlocked": false,
  "microphoneForceMute": false,
  "shareDeviceLocationDisabled": false,
  "certificateCredentialConfigurationDisabled": false,
  "securityCommonCriteriaModeEnabled": false
}
