{
  "@odata.type": "#microsoft.graph.androidDeviceOwnerCompliancePolicy",
  "displayName": "Baseline - Android Enterprise (Fully Managed) - Compliance",
  "description": "Security baseline compliance policy for Android Enterprise corporate-owned fully managed (COBO) and dedicated (COSU) devices. Pending updates do not directly fail compliance because OEM/carrier availability is unreliable; set a client-specific minimum security patch level instead. passwordRequiredType is numericComplex for shared/handheld devices - switch to alphanumeric for personal-style corporate phones.",
  "roleScopeTagIds": ["0"],

  "passwordRequired": true,
  "passwordMinimumLength": 6,
  "passwordRequiredType": "numericComplex",
  "passwordMinutesOfInactivityBeforeLock": 15,

  "storageRequireEncryption": true,
  "securityBlockJailbrokenDevices": true,
  "securityRequireSafetyNetAttestationBasicIntegrity": true,
  "securityRequireSafetyNetAttestationCertifiedDevice": true,
  "securityRequiredAndroidSafetyNetEvaluationType": "hardwareBacked",
  "securityRequireIntuneAppIntegrity": true,
  "requireNoPendingSystemUpdates": false,

  "deviceThreatProtectionEnabled": false,
  "deviceThreatProtectionRequiredSecurityLevel": "unavailable",
  "advancedThreatProtectionRequiredSecurityLevel": "unavailable",

  "scheduledActionsForRule": [
    {
      "ruleName": "PasswordRequired",
      "scheduledActionConfigurations": [
        {
          "actionType": "block",
          "gracePeriodHours": 168,
          "notificationTemplateId": "",
          "notificationMessageCCList": []
        }
      ]
    }
  ]
}
